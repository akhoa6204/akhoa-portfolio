# Copy this file to .env.local and fill in values from:
# Firebase Console > Project settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=akhoa-portfolio
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@akhoa-portfolio.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://akhoa-portfolio-default-rtdb.asia-southeast1.firebasedatabase.app

# Change after deploying to Vercel
NEXT_PUBLIC_SITE_URL=http://localhost:3000
